# Denominación Institucional de la Dirección Rectora
AGENCY_NAME="Dirección Provincial de Sistemas de Información y Tecnologías"
AGENCY_SHORT_NAME="DPSIT"
AGENCY_ACRONYM="DPSIT"
AGENCY_GOVERNMENT="Subsecretaría de Gobierno Digital"
AGENCY_TAGLINE="Gobernanza TI Provincial"

APP_NAME="ERP DPSIT"
APP_ENV=local
APP_KEY=base64:7K5Z8sKqY5w+0Hk3Q4X9l0gN6m1pB3rT8vU2wX5yZ0A=
APP_DEBUG=true
APP_TIMEZONE=America/Argentina/Buenos_Aires
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Puertos expuestos en el Host
FRONTEND_PORT=3000
BACKEND_PORT=8000
DB_PORT=5432

# Base de datos PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=erp_dpsit
DB_USERNAME=postgres
DB_PASSWORD=secret_dpsit_2026

# Almacenamiento y Archivos
FILESYSTEM_DISK=local

# Sincronización de Usuario para WSL2
UID=1000
GID=1000

# Correo electrónico (desarrollo: Mailpit captura todo y NO reenvía; buzón en http://localhost:8025)
# En desarrollo MAIL_HOST debe ser siempre "mailpit", nunca un SMTP real.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
# MAIL_USERNAME=  (solo para SMTP real con autenticación)
# MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-responder@dpsit.local
MAIL_FROM_NAME="ERP DPSIT"
MAILPIT_UI_PORT=8025

# Módulo de firma digital (tokens)
FIRMA_VIGENCIA_MESES=12
FIRMA_RECORDATORIO_DIAS=30
FIRMA_RECORDATORIO_HORA=08:00
FIRMA_RECORDATORIO_MAX_INTENTOS=3
