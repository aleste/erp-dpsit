# ==============================================================================
# Git Attributes - Normalización de Fin de Línea para Windows y Linux
# ==============================================================================

# Detección automática para archivos de texto
* text=auto

# Scripts de Linux (DEBEN conservar LF siempre para evitar errores en Ubuntu)
*.sh text eol=lf
Makefile text eol=lf
docker/* text eol=lf

# Scripts de Windows PowerShell
*.ps1 text eol=crlf
*.bat text eol=crlf

# Archivos de código fuente y configuración (Normalizados en LF)
*.php text eol=lf
*.vue text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ini text eol=lf
*.conf text eol=lf
.env.example text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
